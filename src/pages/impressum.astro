          <li><a href="#angaben">Angaben</a></li>
          <li><a href="#kontakt">Kontakt</a></li>
          <li><a href="#haftung">Haftung</a></li>
          <li><a href="#urheberrecht">Urheberrecht</a></li>
        </ul>
      </aside>

      <article class="prose">

        <section id="angaben">
          <span class="eyebrow">Angaben gemäß § 5 TMG</span>
          <h2>Anbieter.</h2>
